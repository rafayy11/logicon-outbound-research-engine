# ---------------------------------------------------------------------------
# Clay Public API (https://api.clay.com/public/v0)
# Create under Clay: Settings -> Account -> API keys (beta)
# ---------------------------------------------------------------------------
CLAY_API_KEY=

# Routine ids for Clay-managed functions (from your Clay workspace).
# Leave blank if not yet configured -- the capability validator will report
# each one as unavailable instead of guessing an id.
CLAY_ROUTINE_WORK_EMAIL=
CLAY_ROUTINE_EMPLOYEE_COUNT=
CLAY_ROUTINE_REVENUE=
CLAY_ROUTINE_TECHSTACK=
CLAY_ROUTINE_JOB_OPENINGS=
CLAY_ROUTINE_COMPANY_NEWS=

# Custom research function (Claygent-style) built in Clay's UI.
# Format: function:t_xxxxxxxx
# If the generic {domain, prompt} approach works, only this one is needed.
CLAY_ROUTINE_RESEARCH_GENERIC=

# Fallback: one routine id per research variable, only used if the generic
# function proves unreliable during capability validation.
CLAY_ROUTINE_RESEARCH_REPORTER_COUNT=
CLAY_ROUTINE_RESEARCH_METRO_COUNT=
CLAY_ROUTINE_RESEARCH_OPEN_SCHEDULER_ROLES=
CLAY_ROUTINE_RESEARCH_CLIENT_PORTAL=
CLAY_ROUTINE_RESEARCH_SOFTWARE_MENTIONED=
CLAY_ROUTINE_RESEARCH_ADVERTISED_TURNAROUND=

# ---------------------------------------------------------------------------
# Google Places API (New) -- optional. Omit to skip Google Maps as a source.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Credit / run controls
# ---------------------------------------------------------------------------
CLAY_MAX_BUDGET=
DEFAULT_BATCH_SIZE=25
TARGET_BUFFER_PCT=15

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/outbound_engine.db
LOG_LEVEL=INFO
